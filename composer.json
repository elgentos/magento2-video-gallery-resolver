{
    "name": "elgentos/magento2-gallery-mp4-solver",
    "description": "MP4 support for the Magento media gallery: upload, sync, poster thumbnails and clean deletion of video assets",
    "type": "magento2-module",
    "version": "1.0.3",
    "license": "MIT",
    "require": {
        "php": "~8.3.0||~8.4.0",
        "magento/framework": "*",
        "magento/module-backend": "*",
        "magento/module-cms": "*",
        "magento/module-media-gallery-api": "*",
        "magento/module-media-gallery-integration": "*",
        "magento/module-media-gallery-synchronization": "*",
        "magento/module-media-gallery-synchronization-api": "*",
        "magento/module-media-gallery-ui": "*",
        "magento/module-store": "*"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Elgentos\\GalleryMp4Solver\\": "src/"
        }
    }
}
